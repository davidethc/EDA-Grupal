 showfliers=True)\nplt.title('Boxplot de talla')\nplt.ylabel('Numero talla')\nplt.grid(True, linestyle='--', alpha=0.7)\nplt.show()","user":"anonymous","dateUpdated":"2025-07-27T21:59:12-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752613555297_438244163","id":"paragraph_1752613555297_438244163","dateCreated":"2025-07-15T16:05:55-0500","dateStarted":"2025-07-27T21:59:12-0500","dateFinished":"2025-07-27T21:59:13-0500","status":"FINISHED"},{"text":"%md\n## Columnas sin Outliers","user":"anonymous","dateUpdated":"2025-07-27T22:20:53-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"editorHide":true,"tableHide":false},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Columnas sin Outliers</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753313786620_599513835","id":"paragraph_1753313786620_599513835","dateCreated":"2025-07-23T18:36:26-0500","dateStarted":"2025-07-27T22:20:53-0500","dateFinished":"2025-07-27T22:20:55-0500","status":"FINISHED"},{"text":"%pyspark\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport pandas as pd\n","user":"anonymous","dateUpdated":"2025-07-29T11:22:14-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753674203223_882647706","id":"paragraph_1753674203223_882647706","dateCreated":"2025-07-27T22:43:23-0500","dateStarted":"2025-07-29T11:22:14-0500","dateFinished":"2025-07-29T11:22:16-0500","status":"FINISHED"},{"text":"val columnas = Seq(\n  \"anio_insc\", \"dia_insc\", \"anio_nac\", \"dia_nac\", \"talla\", \"peso\",\n  \"sem_gest\", \"apgar1\", \"apgar5\", \"anio_mad\", \"dia_mad\", \"edad_mad\",\n  \"con_pren\", \"num_emb\", \"num_par\", \"hij_viv\", \"hij_vivm\", \"hij_nacm\"\n)","user":"anonymous","dateUpdated":"2025-07-28T12:29:15-0500","progress":12,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mcolumnas\u001b[0m: \u001b[1m\u001b[32mSeq[String]\u001b[0m = List(anio_insc, dia_insc, anio_nac, dia_nac, talla, peso, sem_gest, apgar1, apgar5, anio_mad, dia_mad, edad_mad, con_pren, num_emb, num_par, hij_viv, hij_vivm, hij_nacm)\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753719890965_60979207","id":"paragraph_1753719890965_60979207","dateCreated":"2025-07-28T11:24:50-0500","dateStarted":"2025-07-28T12:29:15-0500","dateFinished":"2025-07-28T12:29:15-0500","status":"FINISHED"},{"text":"def limpiarColumna(df: org.apache.spark.sql.DataFrame, col: String): org.apache.spark.sql.DataFrame = {\n  val cuartiles = df.stat.approxQuantile(col, Array(0.25, 0.75), 0.01)\n\n  if (cuartiles.length == 2) {\n    val q1 = cuartiles(0)\n    val q3 = cuartiles(1)\n    val iqr = q3 - q1\n    val limInf = q1 - 1.5 * iqr\n    val limSup = q3 + 1.5 * iqr\n\n    df.filter(\n      df(col).isNotNull &&\n      df(col) > limInf &&\n      df(col) < limSup\n    )\n  } else {\n    df // si no hay cuartiles válidos, retorna el df original\n  }\n}\n","user":"anonymous","dateUpdated":"2025-07-29T11:22:20-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mlimpiarColumna\u001b[0m: \u001b[1m\u001b[32m(df: org.apache.spark.sql.DataFrame, col: String)org.apache.spark.sql.DataFrame\u001b[0m\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753723770754_1243304710","id":"paragraph_1753723770754_1243304710","dateCreated":"2025-07-28T12:29:30-0500","dateStarted":"2025-07-29T11:22:20-0500","dateFinished":"2025-07-29T11:22:20-0500","status":"FINISHED"},{"text":"%md\n## Dia de inscripcion (dia_insc)","user":"anonymous","dateUpdated":"2025-07-27T22:55:40-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Dia de inscripcion (dia_insc)</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753674912711_1892797404","id":"paragraph_1753674912711_1892797404","dateCreated":"2025-07-27T22:55:12-0500","dateStarted":"2025-07-27T22:55:40-0500","dateFinished":"2025-07-27T22:55:40-0500","status":"FINISHED"},{"text":"val dfDiaInscLimpio = limpiarColumna(dfNacidosCleanFinal, \"dia_insc\")\ndfDiaInscLimpio.createOrReplaceTempView(\"dia_insc_sin_outliers\")\n","user":"anonymous","dateUpdated":"2025-07-29T11:22:39-0500","progress":80,"config":{"colWidth":6,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language"