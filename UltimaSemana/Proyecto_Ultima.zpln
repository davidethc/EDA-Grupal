roupBy(\"lugar_ocur\")\n    .count()\n    .select(\n      col(\"lugar_ocur\"),\n      col(\"count\"),\n      log(col(\"count\")).alias(\"log_count\")\n    )\n    .orderBy(desc(\"count\"))\n)","user":"anonymous","dateUpdated":"2025-07-29T02:18:46-0500","progress":100,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"lugar_ocur\tcount\tlog_count\nHospital, Clínica o Consultorio Privado\t52317\t10.86507664503757\nEstablecimiento del Ministerio de Salud\t51318\t10.845796846808836\nEstablecimiento del IESS\t13198\t9.487820581943367\nOtro Establecimiento Público\t1160\t7.05617528410041\nEstablecimiento de la Junta de Beneficencia\t897\t6.799055862058796\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=46"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=47"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753773113125_607859367","id":"paragraph_1753773113125_607859367","dateCreated":"2025-07-29T02:11:53-0500","dateStarted":"2025-07-29T02:18:46-0500","dateFinished":"2025-07-29T02:18:48-0500","status":"FINISHED"},{"text":"%md\n## Si la madre sabe leer por la edad\n","user":"anonymous","dateUpdated":"2025-07-29T02:22:35-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Si la madre sabe leer por la edad</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragra