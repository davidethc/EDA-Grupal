etnia\")\n  .agg(\n    first(\"tipo_part\").as(\"tipo_parto_mas_comun\"),\n    max(\"count\").as(\"total\")\n  )\n  .withColumn(\"log_total\", log(col(\"total\")))\n  .select($\"etnia\", $\"tipo_parto_mas_comun\", $\"log_total\", $\"total\")\n\nz.show(dfPartoPorEtnia)","user":"anonymous","dateUpdated":"2025-07-29T11:23:55-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"etnia","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"tipo_part","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"etnia\ttipo_parto_mas_comun\tlog_total\ttotal\nAfroecuatoriana/Afrodescendiente\tNormal\t7.404279118037268\t1643\nBlanca\tCesárea\t6.210600077024653\t498\nIndígena\tNormal\t9.380926672551716\t11860\nMestiza\tCesárea\t11.631188385463462\t112554\nMontubia\tNormal\t7.037905963447182\t1139\nMulata\tNormal\t6.159095388491933\t473\nNegra\tNormal\t7.530479995245536\t1864\nOtra\tNormal\t6.338594078203183\t566\nSin información\tNormal\t8.855948534052018\t7016\n"},{"type":"TEXT","data":"import org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mdfPartoPorEtnia\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [etnia: string, tipo_parto_mas_comun: string ... 2 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.17.166.174:4040/jobs/job?id=22"},{"jobUrl":"http://172.17.166.174:4040/jobs/job?id=23"},{"jobUrl":"http://172.17.166.174:4040/jobs/job?id=24"},{"jobUrl":"http://172.17.166.174:4040/jobs/job?id=25"},{"jobUrl":"http://172.17.166.174:4040/jobs/job?id=26"}],