1922518_2109659879","dateCreated":"2025-07-02T18:51:56-0500","status":"READY"},{"text":"ENV_copia\n    .select(\"anio_insc\",\"dia_insc\",\"anio_nac\",\"dia_nac\")\n    .describe()\n    .show\n","user":"anonymous","dateUpdated":"2025-07-02T18:58:37-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"},"colWidth":12,"fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------+------------------+------------------+------------------+------------------+\n|summary|         anio_insc|          dia_insc|          anio_nac|           dia_nac|\n+-------+------------------+------------------+------------------+------------------+\n|  count|            241295|            241295|            241295|            241295|\n|   mean|2023.0647378454437|15.856224576692474|2022.9372345054808|15.632362875318593|\n| stddev| 0.683659975442963|  8.68578751163272|1.5180530471160614| 8.784520746500082|\n|    min|                  |                  |              1900|                 1|\n|    max|              2024|                 9|              2023|                31|\n+-------+------------------+------------------+------------------+------------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.17.167.212:4040/jobs/job?id=184"},{"jobUrl":"http://172.17.167.212:4040/jobs/job?id=185"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1751500316541_33316898","id":"paragraph_1750293204189_1700663554","dateCreated":"2025-07-02T18:51:56-0500","dateStarted":"2025-07-02T18:58:37-0500","dateFinished":"2025-07-02T18:58:39-0500","status":"FINISHED"},{"text":"%md\r\n## Transformaciones\r\nComo ya conocen existen al menos 3 columnas que contienen valores que puedesn convertirse en fecha, aunque ahora mismo estan almacenadas cono cadenas de texto (String).\r\n\r\nEl formato de la fecha es: Año/Mes/Dia, ese formato se puede representar asi : YYYY/MM/dd.","user":"anonymous","dateUpdated":"2025-07-29T01:16:46-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Transformaciones</h2>\n<p>Como ya conocen existen al menos 3 columnas que contienen valores que puedesn convertirse en fecha, aunque ahora mismo estan almacenadas cono cadenas de texto (String).</p>\n<p>El formato de la fecha es: Año/Mes/Dia, ese formato se puede representar asi : YYYY/MM/dd.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1751500316547_134226189","id":"paragraph_1750295362483_1814591263","dateCreated":"2025-07-02T18:51:56-0500","dateStarted":"2025-07-29T01:16:46-0500","dateFinished":"2025-07-29T01:16:46-0500","status":"FINISHED"},{"text":"val dfENV_copiaClean = ENV_copia\r\n    .withColumn(\"fecha_insc_date\",to_date(col(\"fecha_insc\"),\"yyyy/MM/dd\"))\r\n    .withColumn(\"fecha_nac_date\",to_date(col(\"fecha_nac\"),\"yyyy/MM/dd\"))\r\n    .withColumn(\"fecha_mad_date\",to_date(col(\"fecha_mad\"),\"yyyy/MM/dd\"))","user":"anonymous","dateUpdated":"2025-07-30T20:46:39-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mdfENV_copiaClean\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [prov_insc: string, cant_insc: string ... 48 more fields]\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1751500316551_275407966","id":"paragraph_1750296213335_1680824115","dateCreated":"2025-07-02T18:51:56-0500","dateStarted":"2025-07-30T20:46:39-0500","dateFinished":"2025-07-30T20:46:40-0500","status":"FINISHED"},{"text":"dfENV_copiaClean.select(numericCols.map(col):_*).summary().show","user":"anonymous","dateUpdated":"2025-07-02T18:51:56-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------+------------------+------------------+------------------+\n|summary|          anio_nac|           dia_nac|           hij_viv|\n+-------+------------------+------------------+------------------+\n|  count|            241295|            241295|            241295|\n|   mean|2022.9372345054808|15.632362875318593|2.0577550301498166|\n| stddev|1.5180530471163742| 8.784520746500172|1.2242374055754184|\n|    min|              1900|                 1|                 1|\n|    25%|              2023|                 8|                 1|\n|    50%|              2023|                16|                 2|\n|    75%|              2023|                23|                 3|\n|    max|              2023|                31|                16|\n+-------+------------------+------------------+------------------+\n\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1751500316557_1105830327","id":"paragraph_1750296965686_793750091","dateCreated":"2025-07-02T18:51:56-0500","status":"READY"},{"text":"import org.apache.spark.sql.functions._\r\nimport org.apache.spark.sql.types._\r\n\r\n// Obtener los nombres de las columnas de tipo IntegerType\r\nval integerColumnNames = dfENV_copiaClean\r\n    .schema\r\n    .fields\r\n    .filter {\r\n        case StructField(_, IntegerType, _, _) => true\r\n        case _ => false\r\n    }\r\n    .map(_.name)\r\n\r\n// Crear expresiones de cálculo de estadísticas comunes para columnas de tipo Integer\r\nval statsExprs = integerColumnNames\r\n    .flatMap { colName =>\r\n        Seq(\r\n            count(col(colName)).alias(s\"${colName}_count\"),\r\n            min(col(colName)).alias(s\"${colName}_min\"),\r\n            max(col(colName)).alias(s\"${colName}_max\"),\r\n            countDistinct(col(colName)).alias(s\"${colName}_countDistinct\")\r\n        )\r\n    }\r\n\r\n// Aplicar las expresiones y calcular las estadísticas\r\nval dfStatsIntegerCols = dfENV_copiaClean\r\n    .select(statsExprs: _*)\r\n\r\n// Mostrar el resultado\r\ndfStatsIntegerCols.show()\r\n","user":"anonymous","dateUpdated":"2025-07-30T20:46:44-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------+------------+------------+----------------------+-------------+-----------+-----------+---------------------+-------------+-----------+-----------+---------------------+\n|anio_nac_count|anio_nac_min|anio_nac_max|anio_nac_countDistinct|dia_nac_count|dia_nac_min|dia_nac_max|dia_nac_countDistinct|hij_viv_count|hij_viv_min|hij_viv_max|hij_viv_countDistinct|\n+--------------+------------+------------+----------------------+-------------+-----------+-----------+---------------------+-------------+-----------+-----------+---------------------+\n|        241295|        1900|        2023|                    41|       241295|          1|         31|                   31|       241295|          1|         16|                   15|\n+--------------+------------+------------+----------------------+-------------+-----------+-----------+---------------------+-------------+-----------+-----------+---------------------+\n\nimport org.apache.spark.sql.functions._\nimport org.apache.spark.sql.types._\n\u001b[1m\u001b[34mintegerColumnNames\u001b[0m: \u001b[1m\u001b[32mArray[String]\u001b[0m = Array(anio_nac, dia_nac, hij_viv)\n\u001b[1m\u001b[34mstatsExprs\u001b[0m: \u001b[1m\u001b[32mArray[org.apache.spark.sql.Column]\u001b[0m = Array(count(anio_nac) AS anio_nac_count, min(anio_nac) AS anio_nac_min, max(anio_nac) AS anio_nac_max, count(anio_nac) AS anio_nac_countDistinct, count(dia_nac) AS dia_nac_count, min(dia_nac) AS dia_nac_min, max(dia_nac) AS dia_nac_max, count(dia_nac) AS dia_nac_countDistinct, count(hij_viv) AS hij_viv_count, min(hij_viv) AS hij_viv_min, max(hij_viv) AS hij_viv_max, count(hij_viv) AS hij_viv_countDistinct)\n\u001b[1m\u001b[34mdfStatsIntegerCols\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [anio_nac_count: bigint, anio_nac_min: int ... 10 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=2"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=3"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=4"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1751500316565_2136091220","id":"paragraph_1750898121225_1305991766","dateCreated":"2025-07-02T18:51:56-0500","dateStarted":"2025-07-30T20:46:44-0500","dateFinished":"2025-07-30T20:46:50-0500","status":"FINISHED"},{"text":"%md\r\n## Como transformar esas columnas a numero\r\nYa que filtramos las columnas que deberian ser de tipo entero, debemos transformarlas para poder procesarlas","user":"anonymous","dateUpdated":"2025-07-02T19:02:49-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false,"completionKey":"TAB"},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Como transformar esas columnas a numero</h2>\n<p>Ya que filtramos las columnas que deberian ser de tipo entero, debemos transformarlas para poder procesarlas</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1751500316574_624147231","id":"paragraph_1751476122776_1948289936","dateCreated":"2025-07-02T18:51:56-0500","dateStarted":"2025-07-02T19:02:49-0500","dateFinished":"2025-07-02T19:02:49-0500","status":"FINISHED"},{"text":"import org.apache.spark.sql.functions._\r\n\r\n// Lista de columnas a transformar\r\nval columnas = Seq(\r\n  \"anio_insc\", \"dia_insc\", \"anio_nac\", \"dia_nac\", \"talla\", \"peso\",\r\n  \"sem_gest\", \"apgar1\", \"apgar5\", \"anio_mad\", \"dia_mad\", \"edad_mad\",\r\n  \"con_pren\", \"num_emb\", \"num_par\", \"hij_viv\", \"hij_vivm\", \"hij_nacm\"\r\n)\r\n\r\n// Usando foldLeft para transformar de String a Int\r\nval dfNacidosCleanFinal = columnas.foldLeft(dfENV_copiaClean) { (dfTemp, colName) =>\r\n  dfTemp.withColumn(colName, col(colName).cast(\"int\"))\r\n}\r\n\r\n// Mostrar una muestra de las primeras filas para verificar la transformación\r\ndfNacidosCleanFinal.show()\r\n","user":"anonymous","dateUpdated":"2025-07-30T20:46:48-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------------+--------------------+--------------------+----------+---------+----------+--------+------+----------+--------+----------+-------+-----+----+--------+---------+--------------------+------+------+------+--------------------+--------------------+--------------------+--------+--------------------+-----------+--------+----------+----