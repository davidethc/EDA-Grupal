pView(\"dfNacidosCleanFinal\")\n\n// Verificar\nspark.sql(\"SELECT COUNT(*) as total_registros FROM dfNacidosCleanFinal\").show()\n","user":"anonymous","dateUpdated":"2025-07-30T20:54:38-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+---------------+\n|total_registros|\n+---------------+\n|         241295|\n+---------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=52"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=53"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753893360565_638537417","id":"paragraph_1753893360565_638537417","dateCreated":"2025-07-30T11:36:00-0500","dateStarted":"2025-07-30T20:54:38-0500","dateFinished":"2025-07-30T20:54:38-0500","status":"FINISHED","focus":false},{"text":"%pyspark\ntmp_view_etnia_por_prov = spark.sql(\"\"\"\n    SELECT prov_nac, etnia, COUNT(*) as total\n    FROM dfNacidosCleanFinal\n    WHERE prov_nac IS NOT NULL\n      AND etnia IS NOT NULL\n    GROUP BY prov_nac, etnia\n    ORDER BY prov_nac, total DESC\n\"\"\")\n\n# Convertimos a Pandas\ndf_etnia_por_prov = tmp_view_etnia_por_prov.toPandas()","user":"anonymous","dateUpdated":"2025-07-30T20:54:41-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=54"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=55"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=56"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=57"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753893447805_2139817732","id":"paragraph_1753893447805_2139817732","dateCreated":"2025-07-30T11:37:27-0500","dateStarted":"2025-07-30T20:54:41-0500","dateFinished":"2025-07-30T20:54:42-0500","status":"FINISHED","focus":false},{"text":"%pyspark\n\nestablecimiento_tipo_parto = spark.sql(\"\"\"\n  SELECT lugar_ocur, tipo_part, COUNT(*) as total\n  FROM dfNacidosCleanFinal\n  WHERE lugar_ocur IS NOT NULL AND tipo_part IS NOT NULL\n  GROUP BY lugar_ocur, tipo_part\n  ORDER BY lugar_ocur, tipo_part\n\"\"\")","user":"anonymous","dateUpdated":"2025-07-30T20:54:46-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753893577752_1189840652","id":"paragraph_1753893577752_1189840652","dateCreated":"2025-07-30T11:39:37-0500","dateStarted":"2025-07-30T20:54:46-0500","dateFinished":"2025-07-30T20:54:46-0500","status":"FINISHED","focus":false},{"text":"%pyspark\ndf_estab_tipo = establecimiento_tipo_parto.toPandas()\n\nplt.figure(figsize=(16,7))\nsns.barplot(data=df_estab_tipo, x=\"lugar_ocur\", y=\"total\", hue=\"tipo_part\")\nplt.xticks(rotation=45, ha='right')\nplt.title(\"Cantidad de partos por establecimiento y tipo de parto\")\nplt.xlabel(\"Establecimiento\")\nplt.ylabel(\"Cantidad de partos\")\nplt.tight_layout()\nplt.show()","user":"anonymous","dateUpdated":"2025-07-30T20:54:48-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=58"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=59"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=60"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=61"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753888438695_873404660","id":"paragraph_1753888438695_873404660","dateCreated":"2025-07-30T10:13:58-0500","dateStarted":"2025-07-30T20:54:48-0500","dateFinished":"2025-07-30T20:54:49-0500","status":"FINISHED","focus":false},{"text":"%pyspark\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport pandas as pd\n\n# Ejecutamos la consulta para peso por tipo de parto\ntmp_view_peso_parto = spark.sql(\"\"\"\n    SELECT anio_nac, peso, tipo_part \n    FROM dfNacidosCleanFinal \n    WHERE peso IS NOT NULL \n      AND peso > 500 \n      AND peso < 6000\n      AND tipo_part IS NOT NULL\n      AND anio_nac BETWEEN 2015 AND 2023\n\"\"\")\n\n# Convertimos a Pandas\ndf_peso_parto = tmp_view_peso_parto.toPandas()","user":"anonymous","dateUpdated":"2025-07-30T20:54:52-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=62"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753905770464_1230250807","id":"paragraph_1753905770464_1230250807","dateCreated":"2025-07-30T15:02:50-0500","dateStarted":"2025-07-30T20:54:52-0500","dateFinished":"2025-07-30T20:54:54-0500","status":"FINISHED","focus":false},{"text":"%pyspark\n# Gráfico de evolución del peso promedio\npeso_promedio_tiempo = df_peso_parto.groupby(['anio_nac', 'tipo_part'])['peso'].mean().reset_index()\n\nplt.figure(figsize=(12, 6))\nfor tipo in peso_promedio_tiempo['tipo_part'].unique():\n    data_tipo = peso_promedio_tiempo[peso_promedio_tiempo['tipo_part'] == tipo]\n    plt.plot(data_tipo['anio_nac'], data_tipo['peso'], marker='o', label=tipo, linewidth=2)\n\nplt.title('Evolución del Peso Promedio por Tipo de Parto')\nplt.ylabel('Peso Promedio (gramos)')\nplt.xlabel('Año')\nplt.legend(title='Tipo de Parto')\nplt.grid(True, linestyle='--', alpha=0.7)\nplt.show()","user":"anonymous","dateUpdated":"2025-07-30T20:54:55-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753888716401_1056623238","id":"paragraph_1753888716401_1056623238","dateCreated":"2025-07-30T10:18:36-0500","dateStarted":"2025-07-30T20:54:55-0500","dateFinished":"2025-07-30T20:54:55-0500","status":"FINISHED","focus":false},{"text":"%pyspark\n# Convertimos a tabla pivote: filas = provincias, columnas = etnias, valores = total\npivot_table = df_etnia_por_prov.pivot_table(index=\"prov_nac\", columns=\"etnia\", values=\"total\", fill_value=0)\n\n# Gráfico tipo heatmap\nplt.figure(figsize=(14, 8))\nsns.heatmap(pivot_table, annot=True, fmt=\".0f\", cmap=\"YlGnBu\", linewidths=0.5)\n\nplt.title(\"Distribución de etnias por provincia\")\nplt.xlabel(\"Etnia\")\nplt.ylabel(\"Provincia\")\nplt.tight_layout()\nplt.show()\nplt.close()\n","user":"anonymous","dateUpdated":"2025-07-30T20:54:58-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753893324950_841631006","id":"paragraph_1753893324950_841631006","dateCreated":"2025-07-30T11:35:24-0500","dateStarted":"2025-07-30T20:54:58-0500","dateFinished":"2025-07-30T20:54:59-0500","status":"FINISHED","focus":false},{"text":"import org.apache.spark.sql.functions._\n\n// Total de nacimientos\nval totalNacimientos = dfNacidosCleanFinal.count().toDouble\n\n// Porcentaje de nacimientos por área (con 1 decimal)\nval areaPorcentaje = dfNacidosCleanFinal\n  .groupBy(\"area_nac\")\n  .agg(count(\"*\").alias(\"total_nacimientos\"))\n  .withColumn(\"porcentaje\", format_number((col(\"total_nacimientos\") / lit(totalNacimientos)) * 100, 1))\n\n// Tasa de cesáreas (con 1 decimal)\nval cesareasPorArea = dfNacidosCleanFinal\n  .groupBy(\"area_nac\")\n  .agg(\n    sum(when(col(\"tipo_part\") === \"Cesárea\", 1).otherwise(0)).alias(\"total_cesareas\"),\n    count(\"*\").alias(\"total_nacimientos\")\n  )\n  .withColumn(\"tasa_cesareas\", format_number((col(\"total_cesareas\") / col(\"total_nacimientos\")) * 100, 1))\n\n// Mostrar resultados\nz.show(areaPorcentaje)\n","user":"anonymous","dateUpdated":"2025-07-30T20:55:02-0500","progress":25,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"pieChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"area_nac","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"porcentaje","index":2,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"area_nac\ttotal_nacimientos\tporcentaje\nUrbana\t227060\t94.1\nRural\t14235\t5.9\n"},{"type":"TEXT","data":"import org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mtotalNacimientos\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 241295.0\n\u001b[1m\u001b[34mareaPorcentaje\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [area_nac: string, total_nacimientos: bigint ... 1 more field]\n\u001b[1m\u001b[34mcesareasPorArea\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [area_nac: string, total_cesareas: bigint ... 2 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=63"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=64"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=65"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=66"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753892216006_1967231847","id":"paragraph_1753892216006_1967231847","dateCreated":"2025-07-30T11:16:56-0500","dateStarted":"2025-07-30T20:55:02-0500","dateFinished":"2025-07-30T20:55:03-0500","status":"FINISHED","focus":false},{"text":"dfNacidosCleanFinal.select(\"mes_insc\", \"apgar1\", \"apgar5\", \"sexo\")  .createOrReplaceTempView(\"fallecidos_mes\")","user":"anonymous","dateUpdated":"2025-07-30T21:27:30-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753905945444_145170878","id":"paragraph_1753905945444_145170878","dateCreated":"2025-07-30T15:05:45-0500","status":"FINISHED","focus":false,"dateFinished":"2025-07-30T21:27:31-0500","dateStarted":"2025-07-30T21:27:30-0500","results":{"code":"SUCCESS","msg":[]}},{"user":"anonymous","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753928850162_1224923546","id":"paragraph_1753928850162_1224923546","dateCreated":"2025-07-30T21:27:30-0500","status":"FINISHED","text":"%pyspark\n\nfallecidos_por_mes_sexo = spark.sql(\"\"\"\n    SELECT \n        LOWER(mes_insc) AS mes, \n        sexo,\n        COUNT(*) AS total_fallecidos\n    FROM fallecidos_mes\n    WHERE apgar1 IS NULL AND apgar5 IS NULL AND mes_insc IS NOT NULL AND sexo IS NOT NULL\n    GROUP BY LOWER(mes_insc), sexo\n\"\"\")","dateUpdated":"2025-07-30T21:41:32-0500","dateFinished":"2025-07-30T21:41:32-0500","dateStarted":"2025-07-30T21:41:32-0500","results":{"code":"SUCCESS","msg":[]},"focus":false},{"text":"%pyspark\n\n\n# Cargar desde Spark\ndf_fallecidos = fallecidos_por_mes_sexo.toPandas()","user":"anonymous","dateUpdated":"2025-07-30T21:41:47-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=67"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=68"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753929692401_2038458172","id":"paragraph_1753929692401_2038458172","dateCreated":"2025-07-30T21:41:32-0500","status":"FINISHED","focus":false,"dateFinished":"2025-07-30T21:41:49-0500","dateStarted":"2025-07-30T21:41:47-0500","results":{"code":"SUCCESS","msg":[]}},{"text":"%pyspark\n\norden_meses = {\n    \"enero\": 1, \"febrero\": 2, \"marzo\": 3, \"abril\": 4,\n    \"mayo\": 5, \"junio\": 6, \"julio\": 7, \"agosto\": 8,\n    \"septiembre\": 9, \"octubre\": 10, \"noviembre\": 11, \"diciembre\": 12\n}\ndf_fallecidos[\"mes_num\"] = df_fallecidos[\"mes\"].map(orden_meses)\n\n# Pivotear para tener columnas separadas por sexo\ndf_pivot = df_fallecidos.pivot(index=\"mes_num\", columns=\"sexo\", values=\"total_fallecidos\").fillna(0)\n\ndf_pivot = df_pivot.sort_index()\ndf_pivot.index = [list(orden_meses.keys())[i - 1].capitalize() for i in df_pivot.index]","user":"anonymous","dateUpdated":"2025-07-30T21:42:05-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753929707492_1760243352","id":"paragraph_1753929707492_1760243352","dateCreated":"2025-07-30T21:41:47-0500","status":"FINISHED","focus":false,"dateFinished":"2025-07-30T21:42:05-0500","dateStarted":"2025-07-30T21:42:05-0500","results":{"code":"SUCCESS","msg":[]}},{"text":"%pyspark\n# Crear nueva figura\nplt.figure(figsize=(12, 6))\n\n# Dibujar líneas\nplt.plot(df_pivot.index, df_pivot.get(\"Hombre\", []), marker='o', label=\"Hombres\", color=\"blue\")\nplt.plot(df_pivot.index, df_pivot.get(\"Mujer\", []), marker='o', label=\"Mujeres\", color=\"deeppink\")\n\n# Personalización\nplt.title(\"Número Total de Bebés Fallecidos por Mes y Sexo\")\nplt.xlabel(\"Mes\")\nplt.ylabel(\"Número de Fallecidos\")\nplt.xticks(rotation=45)\nplt.grid(axis='y', linestyle='--', alpha=0.6)\nplt.legend()\nplt.tight_layout()\n\n# Mostrar solo una vez\nplt.show()\n","user":"anonymous","dateUpdated":"2025-07-30T21:42:25-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753929725706_944702674","id":"paragraph_1753929725706_944702674","dateCreated":"2025-07-30T21:42:05-0500","status":"FINISHED","focus":false,"dateFinished":"2025-07-30T21:42:25-0500","dateStarted":"2025-07-30T21:42:25-0500","results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div style='width:auto;height:auto'><img src=data:image/png;base64, style='width=auto;height:auto'><div>\n"}]}},{"text":"import org.apache.spark.sql.functions._\n\n// Agrupar por provincia y área\nval distribucionPesoTalla = dfNacidosCleanFinal\n  .groupBy(\"prov_nac\", \"area_nac\")\n  .agg(\n    avg(\"peso\").alias(\"peso_promedio\"),\n    stddev(\"peso\").alias(\"peso_desv_std\"),\n    avg(\"talla\").alias(\"talla_promedio\"),\n    stddev(\"talla\").alias(\"talla_desv_std\"),\n    count(\"*\").alias(\"total_nacimientos\")\n  )\n  .orderBy(desc(\"peso_desv_std\")) // Ordenar por mayor dispersión en peso\n\nz.show(distribucionPesoTalla)\n","user":"anonymous","dateUpdated":"2025-07-30T21:47:38-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=69"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=70"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs