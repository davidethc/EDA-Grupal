g (nullable = true)\n |-- lugar_ocur: string (nullable = true)\n |-- apgar1: integer (nullable = true)\n |-- apgar5: integer (nullable = true)\n |-- p_emb: string (nullable = true)\n |-- prov_nac: string (nullable = true)\n |-- cant_nac: string (nullable = true)\n |-- parr_nac: string (nullable = true)\n |-- area_nac: string (nullable = true)\n |-- asis_por: string (nullable = true)\n |-- nac_mad: string (nullable = true)\n |-- cod_pais: string (nullable = true)\n |-- fecha_mad: string (nullable = true)\n |-- anio_mad: integer (nullable = true)\n |-- mes_mad: string (nullable = true)\n |-- dia_mad: integer (nullable = true)\n |-- edad_mad: integer (nullable = true)\n |-- con_pren: integer (nullable = true)\n |-- num_emb: integer (nullable = true)\n |-- num_par: integer (nullable = true)\n |-- hij_viv: integer (nullable = true)\n |-- hij_vivm: integer (nullable = true)\n |-- hij_nacm: integer (nullable = true)\n |-- etnia: string (nullable = true)\n |-- est_civil: string (nullable = true)\n |-- niv_inst: string (nullable = true)\n |-- sabe_leer: string (nullable = true)\n |-- prov_res: string (nullable = true)\n |-- cant_res: string (nullable = true)\n |-- parr_res: string (nullable = true)\n |-- area_res: string (nullable = true)\n |-- residente: string (nullable = true)\n |-- fecha_insc_date: date (nullable = true)\n |-- fecha_nac_date: date (nullable = true)\n |-- fecha_mad_date: date (nullable = true)\n\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753739192460_1109084952","id":"paragraph_1753739192460_1109084952","dateCreated":"2025-07-28T16:46:32-0500","dateStarted":"2025-07-29T22:17:03-0500","dateFinished":"2025-07-29T22:17:03-0500","status":"FINISHED"},{"text":"val comparacionGeneral = dfNacidosCleanFinal.agg(\n  sum(\"hij_viv\").alias(\"Total nacidos vivos\"),\n  sum(\"hij_vivm\").alias(\"Vivos que luego murieron\")\n)\n\nz.show(comparacionGeneral)\n","user":"anonymous","dateUpdated":"2025-07-30T20:54:21-0500","progress":37,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"Total_Nacidos_Vivos","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"Vivos_que_Luego_Murieron","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"Total nacidos vivos\tVivos que luego murieron\n496526\t5611\n"},{"type":"TEXT","data":"\u001b[1m\u001b[34mcomparacionGeneral\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [Total nacidos vivos: bigint, Vivos que luego murieron: bigint]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=46"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=47"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753845423363_1356855441","id":"paragraph_1753845423363_1356855441","dateCreated":"2025-07-29T22:17:03-0500","dateStarted":"2025-07-30T20:54:21-0500","dateFinished":"2025-07-30T20:54:22-0500","status":"FINISHED","focus":false},{"text":"%md\n## Compara si los casos de bajo peso y pocos controles tienen más probabilidades de tener cesárea o complicaciones en el parto.","user":"anonymous","dateUpdated":"2025-07-30T09:55:56-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Compara si los casos de bajo peso y pocos controles tienen más probabilidades de tener cesárea o complicaciones en el parto.</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753887288053_1226913243","id":"paragraph_1753887288053_1226913243","dateCreated":"2025-07-30T09:54:48-0500","dateStarted":"2025-07-30T09:55:56-0500","dateFinished":"2025-07-30T09:55:56-0500","status":"FINISHED"},{"text":"import org.apache.spark.sql.functions._\n\n// Crear indicador de riesgo perinatal\nval dfRiesgo = dfNacidosCleanFinal.withColumn(\n  \"Riesgo Perinatal\",\n  when(col(\"peso\") < 2500 && col(\"con_pren\") < 4, \"Alto riesgo\").otherwise(\"Riesgo controlado\")\n)\n\n// Agrupar y calcular métricas\nval dfResultado = dfRiesgo.groupBy(\"Riesgo Perinatal\")\n  .agg(\n    sum(when(col(\"tipo_part\") === \"Cesárea\", 1).otherwise(0)).alias(\"Total Cesáreas\"),\n    sum(when(col(\"apgar1\") < 7, 1).otherwise(0)).alias(\"Total Complicaciones\"),\n    count(\"*\").alias(\"Total Nacimientos\")\n  )\n  .withColumn(\"Porcentaje Cesáreas\", format_number((col(\"Total Cesáreas\") / col(\"Total Nacimientos\")) * 100, 2))\n  .withColumn(\"Porcentaje Complicaciones\", format_number((col(\"Total Complicaciones\") / col(\"Total Nacimientos\")) * 100, 2))\n\nz.show(dfResultado)\n","user":"anonymous","dateUpdated":"2025-07-30T20:54:25-0500","progress":75,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"Riesgo Perinatal\tTotal Cesáreas\tTotal Complicaciones\tTotal Nacimientos\tPorcentaje Cesáreas\tPorcentaje Complicaciones\nAlto riesgo\t1421\t689\t3347\t42.46\t20.59\nRiesgo controlado\t117469\t7357\t237948\t49.37\t3.09\n"},{"type":"TEXT","data":"import org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mdfRiesgo\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [prov_insc: string, cant_insc: string ... 49 more fields]\n\u001b[1m\u001b[34mdfResultado\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [Riesgo Perinatal: string, Total Cesáreas: bigint ... 4 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=48"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=49"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753845527689_1832748572","id":"paragraph_1753845527689_1832748572","dateCreated":"2025-07-29T22:18:47-0500","dateStarted":"2025-07-30T20:54:25-0500","dateFinished":"2025-07-30T20:54:26-0500","status":"FINISHED","focus":false},{"text":"dfNacidosCleanFinal.createOrReplaceTempView(\"nacidos\")","user":"anonymous","dateUpdated":"2025-07-30T20:54:31-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753888664336_1863187537","id":"paragraph_1753888664336_1863187537","dateCreated":"2025-07-30T10:17:44-0500","dateStarted":"2025-07-30T20:54:31-0500","dateFinished":"2025-07-30T20:54:32-0500","status":"FINISHED","focus":false},{"text":"%pyspark\nestablecimiento_tipo_parto = spark.sql(\"\"\"\n  SELECT \n    lugar_ocur AS Establecimiento_Ocurrencia,\n    tipo_part AS Tipo_de_Parto,\n    COUNT(*) AS Total_Nacimientos\n  FROM nacidos\n  WHERE lugar_ocur IS NOT NULL AND tipo_part IS NOT NULL\n  GROUP BY lugar_ocur, tipo_part\n  ORDER BY Establecimiento_Ocurrencia, Tipo_de_Parto\n\"\"\")\nz.show(establecimiento_tipo_parto)\n","user":"anonymous","dateUpdated":"2025-07-30T20:54:33-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{