0500","dateFinished":"2025-07-29T02:21:18-0500","status":"FINISHED"},{"text":"%md\n## Consulta para madres > 18 años, que no saben leer, agrupadas por nivel educativo","user":"anonymous","dateUpdated":"2025-07-29T02:22:43-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Consulta para madres &gt; 18 años, que no saben leer, agrupadas por nivel educativo</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753773760158_310521723","id":"paragraph_1753773760158_310521723","dateCreated":"2025-07-29T02:22:40-0500","dateStarted":"2025-07-29T02:22:43-0500","dateFinished":"2025-07-29T02:22:43-0500","status":"FINISHED"},{"text":"val dfFiltrado = dfNacidosCleanFinal\n  .filter(col(\"edad_mad\") > 18)\n  .filter(lower(col(\"sabe_leer\")) === \"no\")\n\nval resultado = dfFiltrado\n  .groupBy(\"niv_inst\")\n  .agg(\n    count(\"*\").alias(\"total_madres\"),\n    sum(\"num_par\").alias(\"total_hijos_vivos\")\n  )\n  .orderBy(desc(\"total_madres\"))\n\nz.show(resultado)\n","user":"anonymous","dateUpdated":"2025-07-29T02:23:06-0500","progress":100,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"niv_inst\ttotal_madres\ttotal_hijos_vivos\nNinguno\t1065\t2716\nCentro de alfabetización\t30\t126\nEducación Básica\t12\t45\nPrimaria\t11\t42\nSin información\t2\t4\n"},{"type":"TEXT","data":"\u001b[1m\u001b[34mdfFiltrado\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [prov_insc: string, cant_insc: s