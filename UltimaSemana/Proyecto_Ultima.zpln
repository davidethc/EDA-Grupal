id":"paragraph_1753733244880_52939322","dateCreated":"2025-07-28T15:07:24-0500","dateStarted":"2025-07-28T15:24:24-0500","dateFinished":"2025-07-28T15:24:24-0500","status":"FINISHED"},{"text":"import org.apache.spark.sql.functions._\n\n// Versión simplificada sin Window\nval dfPartoPorEtnia = dfNacidosCleanFinal\n  .groupBy(\"etnia\", \"tipo_part\")\n  .count()\n  .orderBy($\"etnia\", $\"count\".desc)\n  .groupBy(\"etnia\")\n  .agg(\n    first(\"tipo_part\").as(\"Tipo de parto más común\"),\n    max(\"count\").as(\"Total\")\n  )\n\nz.show(dfPartoPorEtnia)\n","user":"anonymous","dateUpdated":"2025-07-30T20:53:47-0500","progress":12,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"etnia\tTipo de parto más común\tTotal\nAfroecuatoriana/Afrodescendiente\tNormal\t1643\nBlanca\tCesárea\t498\nIndígena\tNormal\t11860\nMestiza\tCesárea\t112554\nMontubia\tNormal\t1139\nMulata\tNormal\t473\nNegra\tNormal\t1864\nOtra\tNormal\t566\nSin información\tNormal\t7016\n"},{"type":"TEXT","data":"import org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mdfPartoPorEtnia\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [etnia: string, Tipo de parto más común: string ... 1 more field]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=23"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=24"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=25"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=26"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=27"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753883694369_1676612065","id":"paragraph_1753883694369_1676612065","dateCrea