ressUpdateIntervalMs":500,"jobName":"paragraph_1753773824632_1336036943","id":"paragraph_1753773824632_1336036943","dateCreated":"2025-07-29T02:23:44-0500","dateStarted":"2025-07-29T02:23:57-0500","dateFinished":"2025-07-29T02:23:57-0500","status":"FINISHED"},{"text":"z.show(\n  dfNacidosCleanFinal.groupBy(\"sexo\")\n    .agg(\n      avg(\"peso\").alias(\"peso_promedio\"),\n      avg(\"talla\").alias(\"talla_promedio\")\n    )\n)","user":"anonymous","dateUpdated":"2025-07-29T02:24:24-0500","progress":11,"config":{"tableHide":false,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"},"colWidth":12,"fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"sexo\tpeso_promedio\ttalla_promedio\nHombre\t3114.3409240035667\t48.79222276452867\nMujer\t3021.027757750541\t48.287046240181546\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=56"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=57"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753773847363_358892122","id":"paragraph_1753773847363_358892122","dateCreated":"2025-07-29T02:24:07-0500","dateStarted":"2025-07-29T02:24:19-0500","dateFinished":"2025-07-29T02:24:22-0500","status":"FINISHED"},{"text":"%md\n## Peso promedio por edad de la madre","user":"anonymous","dateUpdated":"2025-07-29T02:24:52-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Peso promedio por edad de la madre</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753773871494_1569010687","id":"paragraph_1753773871494_1569010687","dateCreated":"2025-07-29T02:24:31-0500","dateStarted":"2025-07-29T02:24:52-0500","dateFinished":"2025-07-29T02:24:52-0500","status":"FINISHED"},{"text":"import org.apache.spark.sql.functions._\n\nval dfEdadPeso = dfNacidosCleanFinal\n  .withColumn(\"Rango de edad\", when(col(\"edad_mad\") < 20, \"Menor 20\")\n                          .when(col(\"edad_mad\").between(20, 29), \"20-29\")\n                          .when(col(\"edad_mad\").between(30, 39), \"30-39\")\n                          .otherwise(\"40 y más\"))\n  .groupBy(\"Rango de edad\")\n  .agg(\n    format_number(avg(\"peso\"), 2).alias(\"Peso promedio\"),  // Redondear a 2 decimales\n    count(\"*\").alias(\"Cantidad\")\n  )\n  .orderBy(\"Rango de edad\")\n\nz.show(dfEdadPeso)","user":"anonymous","dateUpdated":"2025-07-30T22:36:03-0500","progress":100,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"},"scatterChart":{}},"keys":[{"name":"Rango de edad","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"Peso promedio","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"Rango de edad\tPeso promedio\tCantidad\n20-29\t3,074.40\t122592\n30-39\t3,100.63\t71982\n40 y más\t3,060.80\t9694\nMenor 20\t2,988.68\t37027\n"},{"type":"TEXT","data":"import org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mdfEdadPeso\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [Rango de edad: string, Peso promedio: string ... 1 more field]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=14"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=15"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753773894890_66398722","id":"paragraph_1753773894890_66398722","dateCreated":"2025-07-29T02:24:54-0500","dateStarted":"2025-07-30T20:52:47-0500","dateFinished":"2025-07-30T20:52:49-0500","status":"FINISHED","focus":false},{"text":"%md \n# Analisis de Outliers (columna talla)","user":"anonymous","dateUpdated":"2025-07-16T20:03:25-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"editorHide":true,"tableHide":false},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h1>Analisis de Outliers (columna talla)</h1>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1751502673114_1181613746","id":"paragraph_1751502673114_1181613746","dateCreated":"2025-07-02T19:31:13-0500","dateStarted":"2025-07-16T20:03:25-0500","dateFinished":"2025-07-16T20:03:25-0500","status":"FINISHED"},{"text":"%md\n## Metodo de desviacion estandar","user":"anonymous","dateUpdated":"2025-07-15T15:20:26-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Metodo de desviacion estandar</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752610735804_1515663819","id":"paragraph_1752610735804_1515663819","dateCreated":"2025-07-15T15:18:55-0500","dateStarted":"2025-07-15T15:20:26-0500","dateFinished":"2025-07-15T15:20:26-0500","status":"FINISHED"},{"text":"val stats = dfNacidosCleanFinal\n    .select(\n        avg(\"talla\").as(\"media\"),\n        stddev(\"talla\").as(\"desviacion_estandar\")\n).first()","user":"anonymous","dateUpdated":"2025-07-27T21:56:47-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"},"colWidth":12,"fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mstats\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Row\u001b[0m = [48.54522348326832,2.464828327578381]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=53"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=54"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752610826892_317287192","id":"paragraph_1752610826892_317287192","dateCreated":"2025-07-15T15:20:26-0500","dateStarted":"2025-07-27T21:56:47-0500","dateFinished":"2025-07-27T21:56:48-0500","status":"FINISHED"},{"text":"val media = stats.getAs[Double](\"media\")\nval desStand = stats.getAs[Double](\"desviacion_estandar\")\nval umbralDesviacion = 2.0\n","user":"anonymous","dateUpdated":"2025-07-27T21:56:50-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mmedia\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 48.54522348326832\n\u001b[1m\u001b[34mdesStand\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 2.464828327578381\n\u001b[1m\u001b[34mumbralDesviacion\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 2.0\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752611217735_1651907740","id":"paragraph_1752611217735_1651907740","dateCreated":"2025-07-15T15:26:57-0500","dateStarted":"2025-07-27T21:56:50-0500","dateFinished":"2025-07-27T21:56:50-0500","status":"FINISHED"},{"text":"val limiteInfDs = media - umbralDesviacion * desStand\nval limiteSupDS = media + umbralDesviacion * desStand","user":"anonymous","dateUpdated":"2025-07-27T21:56:53-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mlimiteInfDs\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 43.61556682811156\n\u001b[1m\u001b[34mlimiteSupDS\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 53.474880138425085\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752611458160_1535704704","id":"paragraph_1752611458160_1535704704","dateCreated":"2025-07-15T15:30:58-0500","dateStarted":"2025-07-27T21:56:53-0500","dateFinished":"2025-07-27T21:56:53-0500","status":"FINISHED"},{"text":"val outliersDS = dfNacidosCleanFinal\n    .where($\"talla\" < limiteInfDs || $\"talla\" > limiteSupDS)","user":"anonymous","dateUpdated":"2025-07-27T21:56:56-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":