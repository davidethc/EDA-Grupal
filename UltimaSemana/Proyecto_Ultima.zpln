o\").alias(\"peso_promedio\"),\n    count(\"*\").alias(\"cantidad\")\n  )\n  .orderBy(\"rango_edad\")\n\nz.show(dfEdadPeso)\n","user":"anonymous","dateUpdated":"2025-07-29T02:25:13-0500","progress":100,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"rango_edad\tpeso_promedio\tcantidad\n20-29\t3074.398575527256\t122592\n30-39\t3100.6275884721945\t71982\n40 y más\t3060.7979915025107\t9694\nMenor 20\t2988.6827076957634\t37027\n"},{"type":"TEXT","data":"\u001b[1m\u001b[34mdfEdadPeso\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [rango_edad: string, peso_promedio: double ... 1 more field]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=58"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=59"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753773894890_66398722","id":"paragraph_1753773894890_66398722","dateCreated":"2025-07-29T02:24:54-0500","dateStarted":"2025-07-29T02:25:13-0500","dateFinished":"2025-07-29T02:25:16-0500","status":"FINISHED"},{"text":"%md \n# Analisis de Outliers (columna talla)","user":"anonymous","dateUpdated":"2025-07-16T20:03:25-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"editorHide":true,"tableHide":false},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h1>Analisis de Outliers (columna talla)</h1>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1751502673114_1181613746","id":"paragraph_1751502673114_1181613746","dateCreated":"2025-07-02T19:31:13-0500","dateStarted":"2025-07-16T20:03:25-0500","dateFinished":"2025-07-16T20:03:25-0500","status":"FINISHED"},{"text":"%md\n## Metodo de desviacion estandar","user":"anonymous","dateUpdated":"2025-07-15T15:20:26-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Metodo de desviacion estandar</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752610735804_1515663819","id":"paragraph_1752610735804_1515663819","dateCreated":"2025-07-15T15:18:55-0500","dateStarted":"2025-07-15T15:20:26-0500","dateFinished":"2025-07-15T15:20:26-0500","status":"FINISHED"},{"text":"val stats = dfNacidosCleanFinal\n    .select(\n        avg(\"talla\").as(\"media\"),\n        stddev(\"talla\").as(\"desviacion_estandar\")\n).first()","user":"anonymous","dateUpdated":"2025-07-27T21:56:47-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"},"colWidth":12,"fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mstats\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Row\u001b[0m = [48.54522348326832,2.464828327578381]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=53"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=54"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752610826892_317287192","id":"paragraph_1752610826892_317287192","dateCreated":"2025-07-15T15:20:26-0500","dateStarted":"2025-07-27T21:56:47-0500","dateFinished":"2025-07-27T21:56:48-0500","status":"FINISHED"},{"text":"val media = stats.getAs[Double](\"media\")\nval desStand = stats.getAs[Double](\"desviacion_estandar\")\nval umbralDesviacion = 2.0\n","user":"anonymous","dateUpdated":"2025-07-27T21:56:50-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mmedia\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 48.54522348326832\n\u001b[1m\u001b[34mdesStand\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 2.464828327578381\n\u001b[1m\u001b[34mumbralDesviacion\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 2.0\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752611217735_1651907740","id":"paragraph_1752611217735_1651907740","dateCreated":"2025-07-15T15:26:57-0500","dateStarted":"2025-07-27T21:56:50-0500","dateFinished":"2025-07-27T21:56:50-0500","status":"FINISHED"},{"text":"val limiteInfDs = media - umbralDesviacion * desStand\nval limiteSupDS = media + umbralDesviacion * desStand","user":"anonymous","dateUpdated":"2025-07-27T21:56:53-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\u001b[1m\u001b[34mlimiteInfDs\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 43.61556682811156\n\u001b[1m\u001b[34mlimiteSupDS\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 53.474880138425085\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jo