:"2025-07-29T02:18:46-0500","dateFinished":"2025-07-29T02:18:48-0500","status":"FINISHED"},{"text":"%md\n## Si la madre sabe leer por la edad\n","user":"anonymous","dateUpdated":"2025-07-29T02:22:35-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Si la madre sabe leer por la edad</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753773646853_104578824","id":"paragraph_1753773646853_104578824","dateCreated":"2025-07-29T02:20:46-0500","dateStarted":"2025-07-29T02:22:35-0500","dateFinished":"2025-07-29T02:22:35-0500","status":"FINISHED"},{"text":"val dfEdadLeer = dfNacidosCleanFinal\n  .withColumn(\"rango_edad\", when(col(\"edad_mad\") < 20, \"Menor 20\")\n                          .when(col(\"edad_mad\").between(20, 29), \"20-29\")\n                          .when(col(\"edad_mad\").between(30, 39), \"30-39\")\n                          .otherwise(\"40 y más\"))\n  .groupBy(\"rango_edad\", \"sabe_leer\")\n  .count()\n  .orderBy(\"rango_edad\", \"sabe_leer\")\n\nz.show(dfEdadLeer)\n\n","user":"anonymous","dateUpdated":"2025-07-29T02:21:15-0500","progress":100,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"rango_edad\tsabe_leer\tcount\n20-29\tNo\t511\n20-29\tSi\t121893\n20-29\tSin información\t188\n30-39\tNo\t409\n30-39\tSi\t71473\n30-39\tSin información\t100\n40 y más\tNo\t146\n40 y más\tSi\t9450\n40 y más\tSin información\t98\nMenor 20\tNo\t235\nMenor 20\tSi\t36703\nMenor 20\tSin información\t89\n"},{"type":"TEXT","data":"\u001b[1m\u001b[34mdfEdadLeer\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [rango_edad: string, sabe_leer: string ... 1 more field]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=52"},{"jobUrl":"http://192.168.101.5:4040/jobs/job?id=53"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753773665499_911662812","id":"paragraph_1753773665499_911662812","dateCreated":"2025-07-29T02:21:05-0500","dateStarted":"2025-07-29T02:21:15-0500","dateFinished":"2025-07-29T02:21:18-0500","status":"FINISHED"},{"text":"%md\n## Consulta para madres > 18 años, que no saben leer, agrupadas por nivel educativo","user":"anonymous","dateUpdated":"2025-07-29T02:22:43-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Consulta para madres &gt; 18 años, que no saben leer, agrupadas por nivel educativo</h2>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753773760158_310521723","id":"paragraph_1753773760158_310521723","dateCreated":"2025-07-29T02:22:40-0500","dateStarted":"2025-07-29T02:22:43-0500","dateFinished":"2025-07-29T02:22:43-0500","status":"FINISHED"},{"text":"val dfFiltrado = dfNacidosCleanFinal\n  .filter(col(\"edad_mad\") > 18)\n  .filter(lower(col(\"sabe_leer\")) === \"no\")\n\nval resultado = dfFiltrado\n  .groupBy(\"niv_inst\")\n  .agg(\n    count(\"*\").alias(\"total_madres\"),\n    sum(\"num_par\").alias(\"total_hijos_vivos\")\n  )\n  .orderBy(desc(\"total_madres\"))\n\nz.show(resultado)\n","user":"anonymous","dateU