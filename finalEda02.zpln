Infos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752525679153_1921933269","id":"paragraph_1752525679153_1921933269","dateCreated":"2025-07-14T15:41:19-0500","dateStarted":"2025-07-27T00:57:12-0500","dateFinished":"2025-07-27T00:57:12-0500","status":"FINISHED"},{"text":" dfENV_copiaClean\n    .select(\n        min($\"fecha_insc_date\"),\n        max($\"fecha_insc_date\"),\n        count($\"fecha_insc_date\"),\n        countDistinct($\"fecha_insc_date\")\n    )\n    .show()\n","user":"anonymous","dateUpdated":"2025-07-27T00:57:13-0500","progress":10,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------------+--------------------+----------------------+-------------------------------+\n|min(fecha_insc_date)|max(fecha_insc_date)|count(fecha_insc_date)|count(DISTINCT fecha_insc_date)|\n+--------------------+--------------------+----------------------+-------------------------------+\n|          2001-01-01|          2024-04-30|                231333|                            452|\n+--------------------+--------------------+----------------------+-------------------------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.3.194:4040/jobs/job?id=206"},{"jobUrl":"http://192.168.3.194:4040/jobs/job?id=207"},{"jobUrl":"http://192.168.3.194:4040/jobs/job?id=208"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752525794304_509449932","id":"paragraph_1752525794304_509449932","dateCreated":"2025-07-14T15:43:14-0500","dateStarted":"2025-07-27T00:57:13-0500","dateFinished":"2025-07-27T00:57:15-0500","status":"FINISHED"},{"text":" dfENV_copiaClean\n    .select(\n        min($\"fecha_mad_date\"),\n        max($\"fecha_mad_date\"),\n        count($\"fecha_mad_date\"),\n        countDistinct($\"fecha_mad_date\")\n    )\n    .show()\n","user":"anonymous","dateUpdated":"2025-07-27T00:57:14-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------------------+-------------------+---------------------+------------------------------+\n|min(fecha_mad_date)|max(fecha_mad_date)|count(fecha_mad_date)|count(DISTINCT fecha_mad_date)|\n+-------------------+-------------------+---------------------+------------------------------+\n|         1920-12-13|         2014-12-29|               239787|                         11994|\n+-------------------+-------------------+---------------------+------------------------------+\n\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.3.194:4040/jobs/job?id=209"},{"jobUrl":"http://192.168.3.194:4040/jobs/job?id=210"},{"jobUrl":"http://192.168.3.194:4040/jobs/job?id=211"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752525852575_1364492218","id":"paragraph_1752525852575_1364492218","dateCreated":"2025-07-14T15:44:12-0500","dateStarted":"2025-07-27T00:57:15-0500","dateFinished":"2025-07-27T00:57:16-0500","status":"FINISHED"},{"text":"%md \n### 2.2) Identificar conlumnas enteras sapark","user":"anonymous","dateUpdated":"2025-07-25T01:19:50-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>2.2) Identificar conlumnas enteras sapark</h3>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752526089677_1321087814","id":"paragraph_1752526089677_1321087814","dateCreated":"2025-07-14T15:48:09-0500","dateStarted":"2025-07-25T01:19:50-0500","dateFinished":"2025-07-25T01:19:50-0500","status":"FINISHED"},{"text":"import org.apache.spark.sql.functions._\nimport org.apache.spark.sql.types._\n\n// Obtener los nombres de las columnas de tipo IntegerType\nval integerColumnNames = dfENV_copiaClean\n    .schema\n    .fields\n    .filter {\n        case StructField(_, IntegerType, _, _) => true\n        case _ => false\n    }\n    .map(_.name)\n\n// Crear expresiones de cálculo de estadísticas comunes para columnas de tipo Integer\nval statsExprs = integerColumnNames\n    .flatMap { colName =>\n        Seq(\n            count(col(colName)).alias(s\"${colName}_count\"),\n            min(col(colName)).alias(s\"${colName}_min\"),\n            max(col(colName)).alias(s\"${colName}_max\"),\n            countDistinct(col(colName)).alias(s\"${colName}_countDistinct\")\n        )\n    }\n\n// Aplicar las expresiones y calcular las estadísticas\nval dfStatsIntegerCols = dfENV_copiaClean\n    .select(statsExprs: _*)\n\n// Mostrar el resultado\ndfStatsIntegerCols.show()\n","user":"anonymous","dateUpdated":"2025-07-26T23:28:48-0500","progress":12,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------+------------+------------+----------------------+-------------+-----------+-----------+---------------------+-------------+-----------+-----------+---------------------+\n|anio_nac_count|anio_nac_min|anio_nac_max|anio_nac_countDistinct|dia_nac_count|dia_nac_min|dia_nac_max|dia_nac_countDistinct|hij_viv_count|hij_viv_min|hij_viv_max|hij_viv_countDistinct|\n+--------------+------------+------------+----------------------+-------------+-----------+-----------+---------------------+-------------+-----------+-----------+---------------------+\n|        241295|        1900|        2023|                    41|       241295|          1|         31|                   31|       241295|          1|         16|                   15|\n+--------------+------------+------------+----------------------+-------------+-----------+-----------+---------------------+-------------+-----------+-----------+---------------------+\n\nimport org.apache.spark.sql.functions._\nimport org.apache.spark.sql.types._\n\u001b[1m\u001b[34mintegerColumnNames\u001b[0m: \u001b[1m\u001b[32mArray[String]\u001b[0m = Array(anio_nac, dia_nac, hij_viv)\n\u001b[1m\u001b[34mstatsExprs\u001b[0m: \u001b[1m\u001b[32mArray[org.apache.spark.sql.Column]\u001b[0m = Array(count(anio_nac) AS anio_nac_count, min(anio_nac) AS anio_nac_min, max(anio_nac) AS anio_nac_max, count(anio_nac) AS anio_nac_countDistinct, count(dia_nac) AS dia_nac_count, min(dia_nac) AS dia_nac_min, max(dia_nac) AS dia_nac_max, count(dia_nac) AS dia_nac_countDistinct, count(hij_viv) AS hij_viv_count, min(hij_viv) AS hij_viv_min, max(hij_viv) AS hij_viv_max, count(hij_viv) AS hij_viv_countDistinct)\n\u001b[1m\u001b[34mdfStatsIntegerCols\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [anio_nac_count: bigint, anio_nac_min: int ... 10 more fields]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.3.194:4040/jobs/job?id=102"},{"jobUrl":"http://192.168.3.194:4040/jobs/job?id=103"},{"jobUrl":"http://192.168.3.194:4040/jobs/job?id=104"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752526191558_1982275663","id":"paragraph_1752526191558_1982275663",