               .when(col(\"edad_mad\").between(30, 39), \"30-39\")\n                          .otherwise(\"40 y más\"))\n  .groupBy(\"rango_edad\", \"sabe_leer\")\n  .count()\n  .orderBy(\"rango_edad\", \"sabe_leer\")\n\nz.show(dfEdadLeer)\n","dateUpdated":"2025-07-27T00:25:18-0500","dateFinished":"2025-07-27T00:25:19-0500","dateStarted":"2025-07-27T00:25:18-0500","results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"rango_edad\tsabe_leer\tcount\n20-29\tNo\t511\n20-29\tSi\t121893\n20-29\tSin información\t188\n30-39\tNo\t409\n30-39\tSi\t71473\n30-39\tSin información\t100\n40 y más\tNo\t146\n40 y más\tSi\t9450\n40 y más\tSin información\t98\nMenor 20\tNo\t235\nMenor 20\tSi\t36703\nMenor 20\tSin información\t89\n"},{"type":"TEXT","data":"\u001b[1m\u001b[34mdfEdadLeer\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [rango_edad: string, sabe_leer: string ... 1 more field]\n"}]},"focus":false},{"user":"anonymous","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753594386317_1039567869","id":"paragraph_1753594386317_1039567869","dateCreated":"2025-07-27T00:33:06-0500","status":"READY","text":"Consulta para madres > 18 años, que no saben leer, agrupadas por nivel educativo","focus":false,"dateUpdated":"2025-07-27T00:33:21-0500","results":{}},{"user":"anonymous","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.3.194:4040/jobs/job?id=184"},{"jobUrl":"http://192.168.3.194:4040/jobs/job?id=185"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1753593981040_542787417","id":"paragrap