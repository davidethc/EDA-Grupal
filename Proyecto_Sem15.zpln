erían ser Integer pero son String\r\nval stringColumnsButShouldBeInteger = Seq(\"cant_insc\", \"anio_insc\", \"mes_insc\", \"dia_insc\", \"hij_vivm\", \"hij_nacm\", \"num_emb\", \"num_par\", \"edad_mad\")","user":"anonymous","dateUpdated":"2025-07-17T00:20:48+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"import org.apache.spark.sql.types._\n\u001b[1m\u001b[34mintegerColumns\u001b[0m: \u001b[1m\u001b[32mArray[String]\u001b[0m = Array(anio_nac, dia_nac, hij_viv)\n\u001b[1m\u001b[34mstringColumnsButShouldBeInteger\u001b[0m: \u001b[1m\u001b[32mSeq[String]\u001b[0m = List(cant_insc, anio_insc, mes_insc, dia_insc, hij_vivm, hij_nacm, num_emb, num_par, edad_mad)\n"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752711648257_810357995","id":"paragraph_1750899018675_1919138762","dateCreated":"2025-07-17T00:20:48+0000","status":"READY"},{"text":"\r\nval columnas = Seq(\r\n  \"anio_insc\", \"dia_insc\", \"anio_nac\", \"dia_nac\", \"talla\", \"peso\",\r\n  \"sem_gest\", \"apgar1\", \"apgar5\", \"anio_mad\", \"dia_mad\", \"edad_mad\",\r\n  \"con_pren\", \"num_emb\", \"num_par\", \"hij_viv\", \"hij_vivm\", \"hij_nacm\"\r\n)\r\n\r\ncolumnas.foreach { colName =>\r\n  println(s\"\\n=== Frecuencias para '$colName' ===\")\r\n  dfENV_copiaClean\r\n    .groupBy(col(colName))\r\n    .count()\r\n    .orderBy(desc(\"count\"))\r\n    .show() \r\n}","user":"anonymous","dateUpdated":"2025-07-17T00:20:48+0000","progress":0,"config":{"tableHide":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"fontSize":9,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\n=== Frecuencias pa